# Copy to ~/carelanka/.env on the server and fill in. Never commit it.

# The server's web address, e.g. carelanka-demo.southeastasia.cloudapp.azure.com
SITE_ADDRESS=

# Make each with: openssl rand -hex 32
# DB_PASSWORD is the database owner, used only to update the tables.
# DB_APP_PASSWORD is the API's limited login: it can read and write rows, nothing more.
CARELANKA_DB_PASSWORD=
CARELANKA_DB_APP_PASSWORD=
CARELANKA_JWT_SIGNING_KEY=

# Optional. Without it the agents use their rule-based fallback.
CARELANKA_GEMINI_API_KEY=
