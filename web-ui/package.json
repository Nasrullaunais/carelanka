{
  "name": "carelanka-web-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "codegen": "openapi-ts",
    "check:codegen": "openapi-ts && git diff --exit-code --stat -- src/services/api/generated"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@tanstack/react-query": "^5.62.7",
    "leaflet": "^1.9.4",
    "react": "^19",
    "react-dom": "^19",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.3",
    "sonner": "^1.7.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
