*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Downloaded by swagger_parser from the running API. The API is the source of
# truth for the contract, so this copy is a build artifact, not a checked-in spec.
swagger.json

# The generated API client is committed whole, .g.dart parts included: without
# them a fresh clone will not compile until someone runs build_runner. The
# repo-wide `mobile-ui/**/*.g.dart` rule still stands for hand-written code.
!lib/services/api_client/**/*.g.dart
