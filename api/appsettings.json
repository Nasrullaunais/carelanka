{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Issuer": "carelanka-api",
    "Audience": "carelanka-clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:5433" ]
  },

  "Emergency": {
    "MinimumReadyCrew": 2,
    "LocationMaxAgeMinutes": 5,
    "HospitalEntrance": {
      "Label": "Emergency entrance, National Hospital of Sri Lanka",
      "Latitude": 6.9186,
      "Longitude": 79.8686
    }
  },

  "Equipment": {
    "ConfirmationCode": "equipment2026",
    "WarningSweepIntervalMinutes": 60,
    "ExpiryWarningDays": 30
  }
}
